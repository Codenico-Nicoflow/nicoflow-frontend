{
  "name": "my-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2.5.8"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native-renderer": "19.1.0"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "turbo build",
    "build:web": "turbo build --filter=nicoflow-frontend",
    "build:mobile": "pnpm --filter nicoflow-mobile build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:strict": "pnpm --filter './apps/**' --filter './packages/**' exec eslint . --max-warnings 0",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:web": "pnpm --filter nicoflow-frontend test",
    "test:web:watch": "pnpm --filter nicoflow-frontend test:watch",
    "test:web:ui": "pnpm --filter nicoflow-frontend test:ui",
    "test:web:coverage": "pnpm --filter nicoflow-frontend test:coverage",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo",
    "prepare": "husky"
  }
}
