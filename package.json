    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.4",
    "msw": "^2.14.6",
    "msw-storybook-addon": "^2.0.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "storybook": "^10.4.6",
    "storybook-addon-remix-react-router": "^6.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
