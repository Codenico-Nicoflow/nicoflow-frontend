{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@nicoflow/shared": ["./packages/shared/src/index.ts"],
      "@nicoflow/shared/types": ["./packages/shared/src/types/index.ts"],
      "@nicoflow/shared/utils": ["./packages/shared/src/utils/index.ts"],
      "__tests__/*": ["./__tests__/*"]
    },
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "__tests__", "**/*.test.ts", "**/*.test.tsx"],
  "exclude": ["node_modules", "dist"]
}
